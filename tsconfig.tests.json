{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "isolatedModules": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true
  },
  "include": [
    "data/helix-resume-evidence.json",
    "lib/application-compiler.ts",
    "lib/helix-boundaries.ts",
    "lib/helix-evidence.ts",
    "lib/request-guards.ts",
    "lib/run-store.ts",
    "lib/schemas.ts",
    "lib/truthfulness.ts",
    "tests/application-compiler.test.ts",
    "tests/helix-boundaries.test.ts",
    "tests/helix-evidence.test.ts",
    "tests/request-guards.test.ts",
    "tests/run-store.test.ts",
    "tests/truthfulness.test.ts",
    "lib/jd-keywords.ts",
    "lib/keyword-align.ts",
    "lib/bullet-strength.ts",
    "lib/summary-composer.ts",
    "lib/dynamic-compiler.ts",
    "services/dynamic-generator.ts",
    "tests/jd-keywords.test.ts",
    "tests/keyword-align.test.ts",
    "tests/bullet-strength.test.ts",
    "tests/summary-composer.test.ts",
    "tests/dynamic-generator.test.ts",
    "tests/dynamic-compiler.test.ts",
    "tests/visual-identity.test.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-dist"
  ]
}
